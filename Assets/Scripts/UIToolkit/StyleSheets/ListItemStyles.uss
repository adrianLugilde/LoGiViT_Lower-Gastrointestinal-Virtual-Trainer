@import url("project://database/Assets/Scripts/UIToolkit/StyleSheets/LoGiViTStyleVariables.uss?fileID=7433441132597879392&guid=fb1cdcbf63e3cc44abfe0966bfe69e51&type=3#LoGiViTStyleVariables");

.list-item {
    flex-grow: 1;
    width: 100%;
    background-color: var(--dark-green);
    flex-direction: row;
    flex-wrap: nowrap;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    border-top-left-radius: 2%;
    border-top-right-radius: 2%;
    border-bottom-right-radius: 2%;
    border-bottom-left-radius: 2%;
    height: 100%;
}

.list-item-data {
    flex-grow: 1;
    flex-direction: column;
    width: 80%;
}

.list-item-image {
    flex-grow: 1;
    width: 20%;
}

.item-title {
    flex-grow: 1;
    height: 60%;
    font-size: 35px;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.item-description {
    flex-grow: 1;
    height: 40%;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.item-text {
    color: rgb(255, 255, 255);
    -unity-font-definition: var(--regular-font);
    flex-grow: 1;
}
