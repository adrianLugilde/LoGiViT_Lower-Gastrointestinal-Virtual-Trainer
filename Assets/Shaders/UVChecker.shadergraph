    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UV_Interpolator",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "int ch = (int)Channel;\r\nif      (ch == 1) Out = UV1;\r\nelse if (ch == 2) Out = UV2;\r\nelse if (ch == 3) Out = UV3;\r\nelse if (ch == 4) Out = UV4;\r\nelse              Out = UV0;\r\n"
}

